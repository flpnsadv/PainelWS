{
  "$description": "Rito Design Tokens v1 — Formato compatível com Design Tokens Community Group",
  "rito": {
    "color": {
      "clay": {
        "100": { "$value": "#F4E1D5", "$type": "color", "$description": "Fundo suave, chips, hover claro" },
        "300": { "$value": "#E2A689", "$type": "color", "$description": "Hover/active da cor de marca" },
        "500": { "$value": "#C97B5F", "$type": "color", "$description": "Cor principal · botões, links, destaques" },
        "700": { "$value": "#A85F47", "$type": "color", "$description": "Hover de botões primários" },
        "800": { "$value": "#8B4A35", "$type": "color", "$description": "Texto sobre fundo Clay 100, eyebrows" }
      },
      "neutral": {
        "creme":      { "$value": "#FAF4EE", "$type": "color", "$description": "Fundo principal (modo claro)" },
        "cremeSoft":  { "$value": "#F2EDE5", "$type": "color", "$description": "Fundo de cards no modo claro" },
        "border":     { "$value": "#EDE3D7", "$type": "color", "$description": "Bordas e divisores sutis" },
        "borderSoft": { "$value": "#F0E8DC", "$type": "color", "$description": "Bordas mais sutis" },
        "textMid":    { "$value": "#7A5A4E", "$type": "color", "$description": "Subtítulos, captions" },
        "textDark":   { "$value": "#3D2620", "$type": "color", "$description": "Texto principal, títulos" }
      },
      "dark": {
        "bg":      { "$value": "#1E1612", "$type": "color" },
        "surface": { "$value": "#2A1F18", "$type": "color" },
        "border":  { "$value": "#3D2C22", "$type": "color" },
        "text":    { "$value": "#FAF4EE", "$type": "color" },
        "textMid": { "$value": "#B5A398", "$type": "color" }
      },
      "semantic": {
        "success":   { "$value": "#7E9968", "$type": "color", "$description": "Verde-oliva — sucesso" },
        "warning":   { "$value": "#D9A152", "$type": "color", "$description": "Âmbar mel — atenção" },
        "error":     { "$value": "#B85A4A", "$type": "color", "$description": "Vermelho-tijolo — erro" },
        "successBg": { "$value": "#ECEFE3", "$type": "color" },
        "warningBg": { "$value": "#FAF1DE", "$type": "color" },
        "errorBg":   { "$value": "#F4DEDA", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "Fraunces, Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily" }
    },
    "radius": {
      "sm":   { "$value": "6px",  "$type": "dimension" },
      "md":   { "$value": "10px", "$type": "dimension" },
      "lg":   { "$value": "16px", "$type": "dimension" },
      "pill": { "$value": "999px","$type": "dimension" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px rgba(61, 38, 32, 0.06)" },
      "md": { "$value": "0 4px 12px rgba(61, 38, 32, 0.08)" },
      "lg": { "$value": "0 12px 32px rgba(61, 38, 32, 0.10)" }
    }
  }
}
